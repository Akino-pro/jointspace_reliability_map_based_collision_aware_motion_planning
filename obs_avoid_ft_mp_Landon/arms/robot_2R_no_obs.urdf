<robot name="2R">

  <link name="world"/>

  <link name="link1">
    <collision name="arm1">
      <origin rpy="0 0 0" xyz="0.5 0 0.0"/>
      <geometry><box size="1.0 0.1 0.1"/></geometry>
    </collision>
    <inertial>
        <mass value="10"/>
        <inertia ixx="0.4" ixy="0.0" ixz="0.0" iyy="0.4" iyz="0.0" izz="0.2"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <axis xyz="0 -1 0"/>
    <parent link="world"/>
    <limit lower="-3.1415" upper="3.1415"/>
    <child link="link1"/>
  </joint>

  <link name="link2">
    <collision name="arm2">
      <origin rpy="0 0 0" xyz="0.5 0 0.0"/>
      <geometry><box size="1.0 0.1 0.1"/></geometry>
    </collision>
    <inertial>
        <mass value="10"/>
        <inertia ixx="0.4" ixy="0.0" ixz="0.0" iyy="0.4" iyz="0.0" izz="0.2"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <origin rpy="0 0 0" xyz="1.0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.1415" upper="3.1415"/>
    <parent link="link1"/>
    <child link="link2"/>
  </joint>

</robot>
