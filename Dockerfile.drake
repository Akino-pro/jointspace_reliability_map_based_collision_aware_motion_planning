FROM robotlocomotion/drake@sha256:d19e6faecd814b04140ab381602c8d43bed1bc9db32a7885e4afb3169cd646a2

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-scipy python3-networkx python3-shapely python3-pip \
    && /usr/bin/python3 -m pip install --break-system-packages trimesh==5.1.1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONPATH=/opt/drake/lib/python3.12/site-packages
ENV PYTHONUNBUFFERED=1
ENV MPLBACKEND=Agg
WORKDIR /workspace
CMD ["/bin/bash"]
